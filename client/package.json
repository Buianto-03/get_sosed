{
  "name": "client",
  "version": "1.0.2",
  "private": true,
  "description": "## React + Typescript + ESLint + Prettier",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && node scripts/check-boundaries.mjs",
    "lint:fix": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "lint:ts": "tsc --noEmit",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "compile": "./node_modules/.bin/tsc",
    "test": "vitest run",
    "start": "npx http-server ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@pbe/react-yandex-maps": "^1.2.5",
    "@reduxjs/toolkit": "^2.2.7",
    "@types/yandex-maps": "^2.1.36",
    "axios": "^1.7.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.22.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^3.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "http-server": "14.1.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.2.5",
    "sass": "1.83.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.2",
    "vitest": "^1.6.1"
  }
}
